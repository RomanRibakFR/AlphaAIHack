              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// конвейер идёт в фоне: опрашиваем заявку, пока она не выйдет из системных статусов",
                  "const app = pm.response.json();",
                  "const auto = [\"submitted\", \"validation\", \"checks\", \"scoring\"];",
                  "const tries = Number(pm.collectionVariables.get(\"tries\") || 0);",
                  "if (auto.includes(app.status.code) && tries < 30) {",
                  "  pm.collectionVariables.set(\"tries\", tries + 1);",
                  "  setTimeout(() => {}, 1000);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set(\"tries\", 0);",
                  "  pm.test(\"заявка дошла до статуса «offer_proposed»\", () => pm.expect(app.status.code).to.eql(\"offer_proposed\"));",
                  "}"
                ]
              }
            }
          ]
        },
