<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_credit" targetNamespace="http://alfa-hack.example/credit-pipeline" exporter="alfa-hack task 4" exporterVersion="1.0">
  <bpmn:error id="Error_source" name="Источник не ответил" errorCode="SOURCE_UNAVAILABLE"/>
  <bpmn:collaboration id="Collaboration_credit">
    <bpmn:participant id="Participant_bank" name="Кредитный конвейер МСБ" processRef="Process_credit"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_credit" name="Рассмотрение кредитной заявки" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_client" name="Клиент (личный кабинет)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_catch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_supp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_supp_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_consider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_offer_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_supp_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_offer_timer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_system" name="Система банка">
        <bpmn:flowNodeRef>T_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_mismatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_fetch_err</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_spec" name="Специалист банка">
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_spec_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_throw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Нужен кредит">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_form" name="Выбрать продукт, заполнить и отправить анкету">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_valid" name="Проверить полноту анкеты">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_complete" name="Данных достаточно?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="L_catch" name="Дополнение данных">
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_L_catch" name="Дополнение данных"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_supp" name="Дополнить данные или загрузить документ">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_supp_exp" name="Срок истёк">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_fetch" name="Запросить данные о компании из источников">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:property id="Prop_DA_sources" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DA_sources"><bpmn:sourceRef>DS_sources</bpmn:sourceRef><bpmn:targetRef>Prop_DA_sources</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_stop" name="Есть стоп-фактор?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_stop" name="Отказ: стоп-фактор">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_mismatch" name="Анкета совпадает со счётом?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_terms" name="Подобрать условия по платёжной нагрузке">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_terms" name="Условия нашлись?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_terms" name="Отказ: нагрузка">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_score" name="Оценить риск: модель PD (задача 2)">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:property id="Prop_DA_model" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DA_model"><bpmn:sourceRef>DS_model</bpmn:sourceRef><bpmn:targetRef>Prop_DA_model</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T_policy" name="Применить кредитную политику">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:property id="Prop_DA_policy" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DA_policy"><bpmn:sourceRef>DS_policy</bpmn:sourceRef><bpmn:targetRef>Prop_DA_policy</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G_decision" name="Решение системы">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_risk" name="Отказ: высокий риск">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_review" name="Рассмотреть заявку с рекомендацией системы">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_spec" name="Решение специалиста">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_spec_rej" name="Отказ специалиста">
      <bpmn:incoming>F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="L_throw" name="Дополнение данных">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_L_throw" name="Дополнение данных"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="T_offer" name="Сформировать предложение">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_consider" name="Рассмотреть предложение">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_accept" name="Принять?">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_cancel" name="Заявка отменена">
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_offer_exp" name="Срок истёк">
      <bpmn:incoming>F30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_sign" name="Подписать договор кодом">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_issue" name="Выдать кредит (симуляция)">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ok" name="Кредит выдан">
      <bpmn:incoming>F32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_supp_timer" name="14 дней" attachedToRef="T_supp">
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_supp_timer"><bpmn:timeDuration>P14D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_offer_timer" name="30 дней" attachedToRef="T_consider">
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_offer_timer"><bpmn:timeDuration>P30D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_fetch_err" name="Источник не ответил" attachedToRef="T_fetch">
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_fetch_err" errorRef="Error_source"/>
    </bpmn:boundaryEvent>
    <bpmn:dataStoreReference id="DS_sources" name="Источники (моки): ЕГРЮЛ, ФНС, ЗСК, БКИ, ГИР БО, счёт"/>
    <bpmn:dataStoreReference id="DS_model" name="Модель PD"/>
    <bpmn:dataStoreReference id="DS_policy" name="Кредитная политика (конфиг)"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_form"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_form" targetRef="T_valid"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T_valid" targetRef="G_complete"/>
    <bpmn:sequenceFlow id="F4" name="нет" sourceRef="G_complete" targetRef="T_supp"/>
    <bpmn:sequenceFlow id="F5" name="да" sourceRef="G_complete" targetRef="T_fetch"/>
    <bpmn:sequenceFlow id="F6" name="дополнено" sourceRef="T_supp" targetRef="T_valid"/>
    <bpmn:sequenceFlow id="F7" sourceRef="L_catch" targetRef="T_supp"/>
    <bpmn:sequenceFlow id="F8" sourceRef="B_supp_timer" targetRef="E_supp_exp"/>
    <bpmn:sequenceFlow id="F9" sourceRef="T_fetch" targetRef="G_stop"/>
    <bpmn:sequenceFlow id="F10" name="да" sourceRef="G_stop" targetRef="E_stop"/>
    <bpmn:sequenceFlow id="F11" name="нет" sourceRef="G_stop" targetRef="G_mismatch"/>
    <bpmn:sequenceFlow id="F12" name="нет: запросить выписку" sourceRef="G_mismatch" targetRef="T_supp"/>
    <bpmn:sequenceFlow id="F13" name="да" sourceRef="G_mismatch" targetRef="T_terms"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T_terms" targetRef="G_terms"/>
    <bpmn:sequenceFlow id="F15" name="нет" sourceRef="G_terms" targetRef="E_terms"/>
    <bpmn:sequenceFlow id="F16" name="да" sourceRef="G_terms" targetRef="T_score"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T_score" targetRef="T_policy"/>
    <bpmn:sequenceFlow id="F18" sourceRef="T_policy" targetRef="G_decision"/>
    <bpmn:sequenceFlow id="F19" name="класс D" sourceRef="G_decision" targetRef="E_risk"/>
    <bpmn:sequenceFlow id="F20" name="нужен специалист" sourceRef="G_decision" targetRef="T_review"/>
    <bpmn:sequenceFlow id="F21" name="автоматически" sourceRef="G_decision" targetRef="T_offer"/>
    <bpmn:sequenceFlow id="F22" sourceRef="T_review" targetRef="G_spec"/>
    <bpmn:sequenceFlow id="F23" name="одобрить" sourceRef="G_spec" targetRef="T_offer"/>
    <bpmn:sequenceFlow id="F24" name="отказать" sourceRef="G_spec" targetRef="E_spec_rej"/>
    <bpmn:sequenceFlow id="F25" name="запросить данные" sourceRef="G_spec" targetRef="L_throw"/>
    <bpmn:sequenceFlow id="F26" sourceRef="T_offer" targetRef="T_consider"/>
    <bpmn:sequenceFlow id="F27" sourceRef="T_consider" targetRef="G_accept"/>
    <bpmn:sequenceFlow id="F28" name="нет" sourceRef="G_accept" targetRef="E_cancel"/>
    <bpmn:sequenceFlow id="F29" name="да" sourceRef="G_accept" targetRef="T_sign"/>
    <bpmn:sequenceFlow id="F30" sourceRef="B_offer_timer" targetRef="E_offer_exp"/>
    <bpmn:sequenceFlow id="F31" sourceRef="T_sign" targetRef="T_issue"/>
    <bpmn:sequenceFlow id="F32" sourceRef="T_issue" targetRef="End_ok"/>
    <bpmn:sequenceFlow id="F33" sourceRef="B_fetch_err" targetRef="T_review"/>
  </bpmn:process>
